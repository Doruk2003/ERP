<!DOCTYPE html>
<html>
  <head>
    <title>ERP</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
  </head>

  <body>
  <!-- Navbar -->
  <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
    <div class="container-fluid">
      <%= link_to "ERP", root_path, class: "navbar-brand" %>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navbarNav">
        <ul class="navbar-nav ms-auto">
            <li class="nav-item">
              <%= link_to "Ana Sayfa", root_path, class: "nav-link" %>
            </li>
            <li class="nav-item">
              <%= link_to "Ürün", products_path, class: "nav-link" %>
            </li>
            <li class="nav-item">
              <%= link_to "Teklif", offers_path, class: "nav-link" %>
            </li>
            <li class="nav-item">
              <%= link_to "Firma", companies_path, class: "nav-link" %>
            </li>
          </ul>
        </ul>
      </div>
    </div>
  </nav>

  <main class="container mt-4">
    <%= yield %>
  </main>

  <!-- Bootstrap JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>